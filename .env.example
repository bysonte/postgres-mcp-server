# ============================================
# PostgreSQL MCP - Bases de datos nombradas
# ============================================
# Copiar a .env junto al proyecto, o guardar en otro lugar y pasar su ruta
# mediante POSTGRES_ENV_PATH en cada arnés. Nunca subir el .env real a Git.
# Un proceso MCP ve todas las bases listadas en ESTE archivo.
# Los nombres usan letras mayúsculas, números y _, y empiezan con letra.
# URL es obligatoria para cada base; el resto es opcional.
# Codificar caracteres especiales de usuario/contraseña en la URL (%40 para @).

# --------------------------------------------
# Base 1: producción (solo lectura)
# --------------------------------------------
POSTGRES_DB_PRODUCTION_URL=postgresql://USER:PASSWORD@prod.example.com:5432/app
POSTGRES_DB_PRODUCTION_DESCRIPTION=Aplicacion de produccion
POSTGRES_DB_PRODUCTION_ENABLE_WRITE=false
POSTGRES_DB_PRODUCTION_ENABLE_MAINTENANCE=false
# POSTGRES_DB_PRODUCTION_MAX_CONNECTIONS=10
# POSTGRES_DB_PRODUCTION_IDLE_TIMEOUT_MS=30000
# POSTGRES_DB_PRODUCTION_STATEMENT_TIMEOUT_MS=30000
# POSTGRES_DB_PRODUCTION_TRANSACTION_TIMEOUT_MS=60000
# POSTGRES_DB_PRODUCTION_MONITOR_INTERVAL_MS=5000
# POSTGRES_DB_PRODUCTION_ENABLE_TRANSACTION_MONITOR=true
# POSTGRES_DB_PRODUCTION_MAX_CONCURRENT_TRANSACTIONS=5

# --------------------------------------------
# Base 2: desarrollo (escritura habilitada)
# --------------------------------------------
POSTGRES_DB_DEVELOPMENT_URL=postgresql://USER:PASSWORD@localhost:5432/app_dev
POSTGRES_DB_DEVELOPMENT_DESCRIPTION=Desarrollo local
POSTGRES_DB_DEVELOPMENT_ENABLE_WRITE=true
POSTGRES_DB_DEVELOPMENT_ENABLE_MAINTENANCE=false
# POSTGRES_DB_DEVELOPMENT_MAX_CONNECTIONS=4
# POSTGRES_DB_DEVELOPMENT_IDLE_TIMEOUT_MS=30000
# POSTGRES_DB_DEVELOPMENT_STATEMENT_TIMEOUT_MS=30000
# POSTGRES_DB_DEVELOPMENT_TRANSACTION_TIMEOUT_MS=60000
# POSTGRES_DB_DEVELOPMENT_MONITOR_INTERVAL_MS=5000
# POSTGRES_DB_DEVELOPMENT_ENABLE_TRANSACTION_MONITOR=true
# POSTGRES_DB_DEVELOPMENT_MAX_CONCURRENT_TRANSACTIONS=2

# --------------------------------------------
# Formato: POSTGRES_DB_<NOMBRE>_<PROPIEDAD>
# --------------------------------------------
# Propiedades:
# URL                         Obligatoria; postgresql://... o postgres://...
# DESCRIPTION                 Descripcion visible en list_databases (sin secretos)
# ENABLE_WRITE                true/false; false por defecto
# ENABLE_MAINTENANCE          true/false; false por defecto
# MAX_CONNECTIONS             Entero positivo; 10 por defecto
# IDLE_TIMEOUT_MS             Entero positivo; 30000 por defecto
# STATEMENT_TIMEOUT_MS        Entero positivo; 30000 por defecto
# TRANSACTION_TIMEOUT_MS      Entero positivo; 60000 por defecto
# MONITOR_INTERVAL_MS         Entero positivo; 5000 por defecto
# ENABLE_TRANSACTION_MONITOR  true/false; true por defecto
# MAX_CONCURRENT_TRANSACTIONS Entero positivo; 5 por defecto
#
# También se pueden definir valores comunes para los límites (PG_MAX_CONNECTIONS,
# PG_IDLE_TIMEOUT_MS, PG_STATEMENT_TIMEOUT_MS, TRANSACTION_TIMEOUT_MS,
# MONITOR_INTERVAL_MS, ENABLE_TRANSACTION_MONITOR y MAX_CONCURRENT_TRANSACTIONS).
# Una propiedad específica de la base tiene prioridad sobre la común.
# ENABLE_WRITE y ENABLE_MAINTENANCE siempre se deciden por base, sin herencia.
